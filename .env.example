# Variables d'environnement — Finance (11-finance)
# Copier ce fichier vers .env et adapter les valeurs si nécessaire.

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
