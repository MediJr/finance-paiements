# Variables d'environnement — Finance Paiements
# Copier ce fichier vers .env et adapter les valeurs.
# Détail de chaque variable : docs/installation.md

# Django
# Production : générer une clé longue et aléatoire, par exemple :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production uniquement (HTTPS) :
# DJANGO_CSRF_TRUSTED_ORIGINS=https://finance.example.com
# TRUST_X_FORWARDED_FOR=True

# PostgreSQL
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Protection contre la force brute
CONNEXION_MAX_ECHECS=5
CONNEXION_DUREE_BLOCAGE_MINUTES=15
